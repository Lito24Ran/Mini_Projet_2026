#: set sx dp(500) #declaration d' une variable dans un fichir kv
#: set sy dp(62)

<NavigationBar>:
    canvas:
        Color:
            rgba:12/255,24/255,75/255,1
        RoundedRectangle:
            pos: self.center_x - self.width * 0.45, self.y + self.height * 0.02
            size: self.width * 0.9, self.height * 0.1
            radius: [dp(16)]
