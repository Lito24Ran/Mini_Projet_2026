#: import utils kivy.utils
#:set couleur_dispo  "#707070"
#:set couleur_lieu "#989898"
#:set bg_liste "#e9e9e9"
#:set color_titre_moto "#212121"
#import BarreRetour barreRetour

MainWidget:

<MainWidget>:

    
    recycleViews: recycleViews

    BoxLayout:
        size: root.size
        pos: root.pos
        RecycleView:
            id: recycleViews
            viewclass: 'MotoWidget'

            canvas.before:
                Color:
                    rgba: utils.get_color_from_hex('#FFFFFF')
                Rectangle:
                    pos: self.pos
                    size: self.size

            RecycleBoxLayout:
                default_size: None, dp(80)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height
                orientation: 'vertical'
                spacing: dp(10)
                padding: [dp(20), dp(50), dp(20), dp(10)]



<MotoWidget>:
   

    size_hint_y: None
    height: dp(80)
    orientation: "vertical"
    #pos_hint: {"top": 1}   
    padding: [0, dp(5), 0, dp(5)]

    canvas.before:
        Color:
            rgba: root.bg_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]
   

    BoxLayout:
        size_hint_y: None
        height: dp(80)
        spacing: dp(10)
        padding: [dp(10), dp(5), dp(10), dp(5)]

        AsyncImage:
            source: "image/utilisateur-50.png"
            size_hint: None, None
            size: dp(50), dp(50)
            pos_hint: {"center_y": 0.5}

        BoxLayout:
            orientation: "vertical"

            TextAlignLeft:
                text: root.nom
                font_size: dp(18)
                bold: True
                color: utils.get_color_from_hex(color_titre_moto)

            BoxLayout:
                spacing: dp(10)
                TextureSize:
                    text: "Indisponible" if  root.disponibile== False else "Dispo"
                    color: (0, 0.6, 0, 1) if root.disponibile else (0.8, 0, 0, 1)
                    bold: True
                TextureSize:
                    text: root.lieu
                    color: utils.get_color_from_hex(couleur_lieu)

        AsyncImage:
            source: "image/images.png"
            size_hint: None, None
            size: dp(60), dp(70)
            pos_hint: {"center_y": 0.5}

    BoxLayout:
        id: detail_box
        size_hint_y: None
        height: 0               
        opacity: 0
        orientation: "vertical"
        padding: [dp(10), dp(5), dp(10), dp(5)]
        spacing: dp(8)

        canvas.before:
            Color:
                rgba: utils.get_color_from_hex("#a4a4a4") + [1]
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(8)]

        TextAlignLeft:
            text: "Description"
            font_size: dp(16)
            bold: True
            color: utils.get_color_from_hex(color_titre_moto)
            size_hint_y: None
            height: dp(20)

        TextAlignLeft:
            text: root.description
            font_size: dp(13)
            color: utils.get_color_from_hex(couleur_lieu)
            size_hint_y: None
            height: dp(60)

<TextAlignLeft@Label>:
    text_size: self.size
    halign: "left"
    valign: "center"

<TextureSize@Label>:
    size_hint: None, None
    size: self.texture_size